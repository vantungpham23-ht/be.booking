# Copy to .env.local and fill from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# MUST match the UUID of the user you sign in with (not the email string).
# Supabase Dashboard → Authentication → Users → click the row → copy "User UID".
# If login "works" but you see "not authorized", this value is wrong for that account.
NEXT_PUBLIC_ALLOWED_ADMIN_USER_ID=your-auth-user-uuid-here
